<Window x:Class="ImageEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageEditor"
        mc:Ignorable="d"
        Title="Обработка изображений — Проект 4" Height="600" Width="1000">
    <Grid>
        <Button
            Content="загрузить изоброжение"
            Click="Button_Click" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="23,25,0,0"
            Width="160"
            Height="35"
            />
        <Button
            Content="Отчистить изображение"
            Click="ClearImageButton_Click"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="195,25,0,0"
            Width="160"
            Height="35"
            />

        <Border
                BorderBrush="Black"
                BorderThickness="1"
                Margin="23,80,23,25"
                >

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="10">
                    <TextBlock
                        Text="Исходное изоброжения"
                        FontSize="16"
                         FontWeight="Black"
                         Margin="0,0,0,10"
                        />
                    <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                        <Image
                            x:Name="PreviewImage"
                            Stretch="Uniform"
                            Height="350"
                            />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10">
                    <TextBlock
                       Text="Обработаное изображение"
                       FontSize="16"
                       FontWeight="Black"
                       Margin="0,0,0,10"
                       />
                    <Border>
                        <Image
                            x:Name="ProcessedImage"
                            Stretch="Uniform"
                            Height="350"
                        />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10">
                    <TextBlock
                        Text="Характеристики Изображение"
                        FontSize="18"
                        FontWeight="Black"
                        TextWrapping="Wrap"
                        Margin="0,0,0,15"
                        />
                    <TextBlock
                        x:Name="ImageInfoText"
                        Text="Загрузите изображение"
                        FontSize="14"
                        TextWrapping="Wrap"
                        />
                    <CheckBox
                        x:Name="EdgesCheckBox"
                        Content="Контуры: вкл/выкл"
                        Margin="0,20,0,0"
                        FontSize="14"
                        Checked="EdgesCheckBox_Changed"
                        Unchecked="EdgesCheckBox_Changed"
                        />
                    <CheckBox
                        x:Name="SharpenCheckBox"
                        Content="Повышение резкости"
                        Margin="0,10,0,0"
                        FontSize="14"
                        Checked="SharpenCheckBox_Changed"
                        Unchecked="SharpenCheckBox_Changed"
                        />
                    <TextBlock
                        Text="новая широна:" Width="216"
                        />
                    <TextBox
                        x:Name="WidthTextBox"
                        Margin="0,5,0,0"
                        />
                    <TextBlock
                        Text="новая высота:"
                        />
                    <TextBox
                        x:Name="HeightTextBox"
                        Margin="0,5,0,0"
                        />
                    <Button
                        Content="Изменить размер"
                        Click="ResizeButton_Click"
                        Padding="8,5"
                        />
                    <Button 
                        Content="Отменить последнее действие"
                        Click="UndoLastAction_Click"
                        Padding="10,5" Width="219"
                        />
                    <Button Content="Сохранить"
                            Click="SaveResult_Click"
                            Margin="0,20,0,0"
                            Padding="8,5"
                            />
                </StackPanel>
            </Grid>
        </Border>


    </Grid>
</Window>